Options -Indexes
ServerSignature Off

# La home pública usa index.php (SSR de proyectos); el panel usa /admin/
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acceso directo a /storage/ (excepto /storage/assets/)
    RewriteCond %{REQUEST_URI} ^/storage/
    RewriteCond %{REQUEST_URI} !^/storage/assets/
    RewriteRule ^ - [F,L]

    # Enrutar /propuesta/{slug} → propuesta/index.php?slug={slug}
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^propuesta/([a-zA-Z0-9_-]+)/?$ propuesta/index.php?slug=$1 [L,QSA]
</IfModule>

# Cabeceras de seguridad
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# PHP: aumentar límites para subida de imágenes
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 22M
    php_value max_execution_time 60
    php_value memory_limit 128M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 22M
    php_value max_execution_time 60
    php_value memory_limit 128M
</IfModule>

# Comprimir recursos estáticos
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Caché para estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
</IfModule>
